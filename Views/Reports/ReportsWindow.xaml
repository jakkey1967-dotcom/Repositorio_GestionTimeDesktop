<Window
    x:Class="GestionTime.Desktop.Views.Reports.ReportsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:GestionTime.Desktop.Helpers"
    xmlns:vm="using:GestionTime.Desktop.ViewModels.Reports"
    mc:Ignorable="d"
    Title="Informes - GestionTime">

    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="20">
        <Grid.Resources>
            <helpers:InverseBoolConverter x:Key="InverseBoolConverter"/>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- GT-BEGIN: Banner con logo e info contextual (SIN controles de búsqueda) -->
        <Border Grid.Row="0" 
                Background="{ThemeResource BannerBg}" 
                Padding="20,16" 
                CornerRadius="10" 
                Margin="0,0,0,16">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo -->
                <Image x:Name="LogoImageBanner"
                       Grid.Column="0"
                       Source="ms-appx:///Assets/LogoOscuro.png"
                       Stretch="Uniform"
                       MaxHeight="50"
                       VerticalAlignment="Center"/>

                <!-- Título + Contexto -->
                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="Informes de Partes"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="White"/>
                    <TextBlock Text="{x:Bind ViewModel.BannerContextText, Mode=OneWay}"
                               FontSize="14"
                               Foreground="#E0E0E0"
                               FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Agente -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="👤"
                               FontSize="16"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{x:Bind ViewModel.AgentDisplayText, Mode=OneWay}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="White"/>
                </StackPanel>
            </Grid>
        </Border>
        <!-- GT-END -->

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="20">

                <!-- GT-BEGIN: Panel de filtros (movido desde banner) -->
                <Border Background="{ThemeResource SurfaceBg}"
                        BorderBrush="{ThemeResource Stroke}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20">
                    <StackPanel Spacing="16">
                        <!-- Alcance -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Alcance:" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextMain}"/>
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <RadioButton Content="Día" 
                                             IsChecked="{x:Bind ViewModel.IsDayScope, Mode=OneWay}"
                                             Click="OnScopeDay_Click"/>
                                <RadioButton Content="Semana" 
                                             IsChecked="{x:Bind ViewModel.IsWeekScope, Mode=OneWay}"
                                             Click="OnScopeWeek_Click"/>
                                <RadioButton Content="Rango" 
                                             IsChecked="{x:Bind ViewModel.IsRangeScope, Mode=OneWay}"
                                             Click="OnScopeRange_Click"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Controles según scope -->
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <!-- Día -->
                            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.DayScopeVisibility, Mode=OneWay}">
                                <TextBlock Text="Fecha:" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextMuted}"/>
                                <CalendarDatePicker Date="{x:Bind ViewModel.SelectedDate, Mode=TwoWay}" Width="200"/>
                            </StackPanel>

                            <!-- Semana -->
                            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.WeekScopeVisibility, Mode=OneWay}">
                                <TextBlock Text="Semana:" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextMuted}"/>
                                <ComboBox ItemsSource="{x:Bind ViewModel.AvailableWeeks, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedWeek, Mode=TwoWay}"
                                          Width="320"
                                          PlaceholderText="Selecciona una semana">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:WeekOption">
                                            <TextBlock Text="{x:Bind Display}" FontSize="13"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <!-- Rango -->
                            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.RangeScopeVisibility, Mode=OneWay}" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Desde:" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextMuted}"/>
                                    <CalendarDatePicker Date="{x:Bind ViewModel.RangeFrom, Mode=TwoWay}" Width="180"/>
                                </StackPanel>
                                <StackPanel Spacing="4" Margin="12,0,0,0">
                                    <TextBlock Text="Hasta:" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextMuted}"/>
                                    <CalendarDatePicker Date="{x:Bind ViewModel.RangeTo, Mode=TwoWay}" Width="180"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- GT-BEGIN: ComboBox de Agente (solo EDITOR/ADMIN) en línea horizontal -->
                            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.CanSelectAgentVisibility, Mode=OneWay}">
                                <TextBlock Text="Agente:" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextMuted}"/>
                                <ComboBox ItemsSource="{x:Bind ViewModel.AvailableAgents, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedAgent, Mode=TwoWay}"
                                          Width="280"
                                          PlaceholderText="Selecciona un agente..."
                                          IsEnabled="{x:Bind ViewModel.IsAgentSelectorEnabled, Mode=OneWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AgentOption">
                                            <TextBlock Text="{x:Bind Display}" FontSize="13"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <!-- GT-END -->

                            <!-- GT-BEGIN: Botón Buscar + Salir + Compartir inline -->
                            <Button Command="{x:Bind ViewModel.SearchCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanSearch, Mode=OneWay}"
                                    Background="{ThemeResource Accent}"
                                    Foreground="White"
                                    Padding="24,12"
                                    CornerRadius="8"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Bottom"
                                    Margin="16,0,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE721;" FontSize="14"/>
                                    <TextBlock Text="Buscar" FontSize="14"/>
                                </StackPanel>
                            </Button>

                            <!-- GT-BEGIN: Botón Salir -->
                            <Button Click="OnSalir_Click"
                                    Background="{ThemeResource Accent}"
                                    Foreground="White"
                                    Padding="24,12"
                                    CornerRadius="8"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Bottom"
                                    Margin="8,0,0,0"
                                    ToolTipService.ToolTip="Cerrar ventana de informes">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72B;" FontSize="14"/>
                                    <TextBlock Text="Salir" FontSize="14"/>
                                </StackPanel>
                            </Button>
                            <!-- GT-END: Botón Salir -->

                            <!-- Separador vertical -->
                            <Border Width="1" Height="28" Background="{ThemeResource Stroke}" Margin="8,0" VerticalAlignment="Bottom"
                                    Visibility="{x:Bind ViewModel.ResumenVisibility, Mode=OneWay}"/>

                            <!-- Compartir -->
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom"
                                        Visibility="{x:Bind ViewModel.ResumenVisibility, Mode=OneWay}">
                                <FontIcon Glyph="&#xE72D;" FontSize="14" Foreground="{ThemeResource TextMuted}" VerticalAlignment="Center"/>
                                <TextBlock Text="Compartir:" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextMuted}" VerticalAlignment="Center"/>
                                <Button Click="OnExportExcel_Click" Padding="10,6" CornerRadius="6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE80A;" FontSize="13"/>
                                        <TextBlock Text="Excel" FontSize="13"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="OnExportPdf_Click" Padding="10,6" CornerRadius="6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8A5;" FontSize="13"/>
                                        <TextBlock Text="PDF" FontSize="13"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="OnShareEmail_Click" Padding="10,6" CornerRadius="6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE715;" FontSize="13"/>
                                        <TextBlock Text="Email" FontSize="13"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <!-- GT-END -->
                        </StackPanel>

                        <!-- GT-BEGIN: Indicador de carga de agentes -->
                        <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.IsLoadingAgentsVisibility, Mode=OneWay}">
                            <ProgressRing IsActive="True" Width="16" Height="16"/>
                            <TextBlock Text="Cargando agentes..." FontSize="12" Foreground="{ThemeResource TextMuted}"/>
                        </StackPanel>
                        <!-- GT-END -->
                    </StackPanel>
                </Border>
                <!-- GT-END -->

                <!-- Errores -->
                <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                         Severity="Error"
                         Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                         IsClosable="True"/>

                <!-- GT-BEGIN: Notificaciones temporales (reemplaza InfoBar fija) -->
                <InfoBar IsOpen="{x:Bind ViewModel.ShowNotification, Mode=TwoWay}"
                         Severity="{x:Bind ViewModel.NotificationSeverity, Mode=OneWay}"
                         Message="{x:Bind ViewModel.NotificationMessage, Mode=OneWay}"
                         IsClosable="True"/>
                <!-- GT-END -->

                <Grid Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}"
                      MinHeight="200">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="16">
                        <ProgressRing IsActive="True" 
                                      Width="60" 
                                      Height="60" 
                                      Foreground="{ThemeResource Accent}"/>
                        <TextBlock Text="⏳ Cargando informe..." 
                                   FontSize="16" 
                                   Foreground="{ThemeResource TextMuted}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <StackPanel Visibility="{x:Bind ViewModel.ResumenVisibility, Mode=OneWay}"
                            Spacing="20">

                    <!-- GT-BEGIN: Totales (cards compactas) -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" 
                                Background="{ThemeResource SurfaceBg}" 
                                BorderBrush="{ThemeResource Stroke}" 
                                BorderThickness="1" 
                                CornerRadius="10" 
                                Padding="14">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8A4;" FontSize="12" Foreground="{ThemeResource TextMuted}"/>
                                    <TextBlock Text="Partes" FontSize="12" Foreground="{ThemeResource TextMuted}"/>
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.Resumen.PartsCount, Mode=OneWay}" 
                                           FontSize="24" 
                                           FontWeight="Bold" 
                                           Foreground="{ThemeResource Accent}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" 
                                Background="{ThemeResource SurfaceBg}" 
                                BorderBrush="{ThemeResource Stroke}" 
                                BorderThickness="1" 
                                CornerRadius="10" 
                                Padding="14">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE823;" FontSize="12" Foreground="{ThemeResource TextMuted}"/>
                                    <TextBlock Text="Registrado" FontSize="12" Foreground="{ThemeResource TextMuted}"/>
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.RecordedTime, Mode=OneWay}" 
                                           FontSize="22" 
                                           FontWeight="Bold" 
                                           Foreground="{ThemeResource TextMain}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" 
                                Background="{ThemeResource SurfaceBg}" 
                                BorderBrush="{ThemeResource Stroke}" 
                                BorderThickness="1" 
                                CornerRadius="10" 
                                Padding="14">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource TextMuted}"/>
                                    <TextBlock Text="Real (sin solape)" FontSize="12" Foreground="{ThemeResource TextMuted}"/>
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.CoveredTime, Mode=OneWay}" 
                                           FontSize="22" 
                                           FontWeight="Bold" 
                                           Foreground="#10B981"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" 
                                Background="{ThemeResource SurfaceBg}" 
                                BorderBrush="{ThemeResource Stroke}" 
                                BorderThickness="1" 
                                CornerRadius="10" 
                                Padding="14">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE7BA;" FontSize="12" Foreground="{ThemeResource TextMuted}"/>
                                    <TextBlock Text="Solape" FontSize="12" Foreground="{ThemeResource TextMuted}"/>
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.OverlapTime, Mode=OneWay}" 
                                           FontSize="22" 
                                           FontWeight="Bold" 
                                           Foreground="#F59E0B"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <!-- GT-END -->

                    <!-- GT-BEGIN: Detalle de solapamientos (visible solo cuando hay overlap) -->
                    <StackPanel Visibility="{x:Bind ViewModel.IsLoadingOverlapVisibility, Mode=OneWay}"
                                HorizontalAlignment="Center" Spacing="8" Margin="0,8">
                        <ProgressRing IsActive="True" Width="24" Height="24"/>
                        <TextBlock Text="Analizando solapamientos..." FontSize="12" Foreground="{ThemeResource TextMuted}"/>
                    </StackPanel>

                    <Border Background="{ThemeResource SurfaceBg}"
                            BorderBrush="#F59E0B"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16"
                            Visibility="{x:Bind ViewModel.OverlapDetailVisibility, Mode=OneWay}">
                        <StackPanel Spacing="12">
                            <!-- Título sección + Botón Solución Automática -->
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE7BA;" FontSize="16" Foreground="#F59E0B"/>
                                    <TextBlock Text="Partes con solapamiento" FontSize="16" FontWeight="SemiBold" Foreground="#F59E0B"/>
                                    <TextBlock Text="— Edita Inicio/Fin para resolver" FontSize="13" Foreground="{ThemeResource TextMuted}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Click="OnAutoFixOverlaps_Click"
                                        Background="#F59E0B" Foreground="Black"
                                        Padding="14,8" CornerRadius="8"
                                        ToolTipService.ToolTip="Ajusta tiempos automáticamente (prioridad al de mayor duración)">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE771;" FontSize="14"/>
                                        <TextBlock Text="Solución Automática" FontSize="13" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Header de la tabla -->
                            <Grid Padding="8,6" Background="{ThemeResource BannerBg}" CornerRadius="6" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="55"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="55"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="ID" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"/>
                                <TextBlock Grid.Column="1" Text="Fecha" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"/>
                                <TextBlock Grid.Column="2" Text="Cliente" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"/>
                                <TextBlock Grid.Column="3" Text="Ticket" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"/>
                                <TextBlock Grid.Column="4" Text="Inicio" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"/>
                                <TextBlock Grid.Column="5" Text="Fin" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"/>
                                <TextBlock Grid.Column="6" Text="Durac." FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"/>
                                <TextBlock Grid.Column="7" Text="Solapa con" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"/>
                                <TextBlock Grid.Column="8" Text="Acción" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                            </Grid>

                            <!-- Lista de partes solapados -->
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.OverlappingParts, Mode=OneWay}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:OverlapPartItem">
                                        <StackPanel Spacing="2" Margin="0,0,0,4">
                                            <Grid Padding="8,6" CornerRadius="6" ColumnSpacing="8"
                                                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="50"/>
                                                    <ColumnDefinition Width="55"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="55"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="120"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" FontSize="12" Foreground="{ThemeResource TextMuted}" VerticalAlignment="Center">
                                                    <Run Text="#"/><Run Text="{x:Bind Id}"/>
                                                </TextBlock>
                                                <TextBlock Grid.Column="1" Text="{x:Bind Fecha}" FontSize="12" Foreground="{ThemeResource TextMain}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{x:Bind Cliente}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextMain}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                                <TextBlock Grid.Column="3" Text="{x:Bind Ticket}" FontSize="12" Foreground="{ThemeResource TextMuted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                                <!-- Inicio: display/edit mode -->
                                                <Grid Grid.Column="4" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind HoraInicio, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="#F59E0B" Visibility="{x:Bind DisplayVisibility, Mode=OneWay}"/>
                                                    <TextBox Text="{x:Bind HoraInicio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             FontSize="12" Padding="4,2" MinWidth="70" MaxWidth="80"
                                                             MaxLength="5" PlaceholderText="HH:mm"
                                                             Visibility="{x:Bind EditingVisibility, Mode=OneWay}"/>
                                                </Grid>

                                                <!-- Fin: display/edit mode -->
                                                <Grid Grid.Column="5" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind HoraFin, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="#F59E0B" Visibility="{x:Bind DisplayVisibility, Mode=OneWay}"/>
                                                    <TextBox Text="{x:Bind HoraFin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             FontSize="12" Padding="4,2" MinWidth="70" MaxWidth="80"
                                                             MaxLength="5" PlaceholderText="HH:mm"
                                                             Visibility="{x:Bind EditingVisibility, Mode=OneWay}"/>
                                                </Grid>

                                                <TextBlock Grid.Column="6" Text="{x:Bind DuracionText}" FontSize="12" Foreground="{ThemeResource TextMuted}" VerticalAlignment="Center"/>

                                                <TextBlock Grid.Column="7" Text="{x:Bind OverlapInfo, Mode=OneWay}" FontSize="11"
                                                           Foreground="#F59E0B" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           ToolTipService.ToolTip="{x:Bind OverlapInfo, Mode=OneWay}"/>

                                                <!-- Botones de acción -->
                                                <StackPanel Grid.Column="8" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <!-- Editar (modo display) -->
                                                    <Button Padding="6,4" CornerRadius="4" Tag="{x:Bind}"
                                                            Visibility="{x:Bind DisplayVisibility, Mode=OneWay}"
                                                            Click="OnEditOverlapPart_Click"
                                                            ToolTipService.ToolTip="Editar tiempos">
                                                        <FontIcon Glyph="&#xE70F;" FontSize="12"/>
                                                    </Button>
                                                    <!-- Guardar (modo edición) -->
                                                    <Button Padding="6,4" CornerRadius="4" Tag="{x:Bind}"
                                                            Visibility="{x:Bind EditingVisibility, Mode=OneWay}"
                                                            Click="OnSaveOverlapPart_Click"
                                                            Background="{ThemeResource Accent}" Foreground="White"
                                                            ToolTipService.ToolTip="Guardar cambios">
                                                        <FontIcon Glyph="&#xE73E;" FontSize="12"/>
                                                    </Button>
                                                    <!-- Cancelar (modo edición) -->
                                                    <Button Padding="6,4" CornerRadius="4" Tag="{x:Bind}"
                                                            Visibility="{x:Bind EditingVisibility, Mode=OneWay}"
                                                            Click="OnCancelOverlapEdit_Click"
                                                            ToolTipService.ToolTip="Cancelar edición">
                                                        <FontIcon Glyph="&#xE711;" FontSize="12"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Error de validación (debajo de la fila) -->
                                            <TextBlock Text="{x:Bind ValidationError, Mode=OneWay}"
                                                       FontSize="11" Foreground="#EF4444" Margin="8,0,0,0"
                                                       Visibility="{x:Bind EditingVisibility, Mode=OneWay}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Border>
                    <!-- GT-END -->

                    <!-- GT-BEGIN: Gráfica semanal -->
                    <Border Background="{ThemeResource SurfaceBg}"
                            BorderBrush="{ThemeResource Stroke}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20"
                            Visibility="{x:Bind ViewModel.WeekChartVisibility, Mode=OneWay}">
                        <StackPanel Spacing="16">
                            <!-- Título y total contextual -->
                            <Grid>
                                <TextBlock Text="📊 Horas por día (Lun-Sáb)"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextMain}"
                                           HorizontalAlignment="Left"/>
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                    <TextBlock Text="{x:Bind ViewModel.TotalHeaderText, Mode=OneWay}"
                                               FontSize="14"
                                               Foreground="{ThemeResource TextMuted}"/>
                                    <TextBlock Text="{x:Bind ViewModel.WeekTotalHours, Mode=OneWay}"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="{ThemeResource Accent}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Agente + Inicio/Fin Global -->
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Agente -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="👤"
                                               FontSize="13"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{x:Bind ViewModel.AgentDisplayText, Mode=OneWay}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextMain}"/>
                                </StackPanel>

                                <!-- Inicio Global -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="🕒"
                                               FontSize="13"
                                               VerticalAlignment="Center"/>
                                    <TextBlock FontSize="13" Foreground="{ThemeResource TextMuted}">
                                        <Run Text="Inicio global:"/>
                                        <Run Text="{x:Bind ViewModel.FirstStartFormatted, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource TextMain}"/>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Fin Global -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="🏁"
                                               FontSize="13"
                                               VerticalAlignment="Center"/>
                                    <TextBlock FontSize="13" Foreground="{ThemeResource TextMuted}">
                                        <Run Text="Fin global:"/>
                                        <Run Text="{x:Bind ViewModel.LastEndFormatted, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource TextMain}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>

                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.WeekChartItems, Mode=OneWay}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WeekChartItem">
                                        <Grid Margin="0,0,0,12" ColumnSpacing="12">
                                            <!-- GT-BEGIN: Informes barras sin % -->
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- GT-END: Informes barras sin % -->

                                            <!-- Etiqueta del día -->
                                            <TextBlock Grid.Column="0"
                                                       Text="{x:Bind DayLabel}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextMuted}"
                                                       VerticalAlignment="Center"/>

                                            <!-- Contenedor de barra con horas superpuestas -->
                                            <Grid Grid.Column="1" HorizontalAlignment="Stretch">
                                                <!-- Barra (normalizada a 8h) -->
                                                <Border Width="{x:Bind BarWidth}"
                                                        Height="28"
                                                        CornerRadius="4"
                                                        Background="{x:Bind BarBrush}"
                                                        HorizontalAlignment="Left"/>

                                                <!-- GT-BEGIN: Informes barras sin % -->
                                                <!-- Texto horas centrado DENTRO de la barra -->
                                                <TextBlock Width="{x:Bind BarWidth}"
                                                           HorizontalAlignment="Left"
                                                           VerticalAlignment="Center"
                                                           TextAlignment="Center"
                                                           Foreground="Black"
                                                           FontWeight="Bold"
                                                           FontSize="13"
                                                           IsHitTestVisible="False"
                                                           Text="{x:Bind HoursText}"/>
                                                <!-- GT-END: Informes barras sin % -->
                                            </Grid>

                                            <!-- GT-BEGIN: Informes barras sin % -->
                                            <!-- Tiempo (solo horas, sin porcentaje) -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind HoursText}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextMain}"/>
                                                <TextBlock Text="⚠️"
                                                           FontSize="12"
                                                           Visibility="{x:Bind IsUnderTarget}"
                                                           ToolTipService.ToolTip="Menos de 8h"/>
                                            </StackPanel>
                                            <!-- GT-END: Informes barras sin % -->
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>

                            <!-- Mensaje si no hay datos -->
                            <TextBlock Text="{x:Bind ViewModel.WeekChartMessage, Mode=OneWay}"
                                       FontSize="13"
                                       Foreground="{ThemeResource TextMuted}"
                                       Visibility="{x:Bind ViewModel.WeekChartMessageVisibility, Mode=OneWay}"/>
                        </StackPanel>
                    </Border>
                    <!-- GT-END -->

                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
