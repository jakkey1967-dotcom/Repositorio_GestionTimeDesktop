<Page
x:Class="GestionTime.Desktop.Views.DiarioPage"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:helpers="using:GestionTime.Desktop.Helpers"
xmlns:local="using:GestionTime.Desktop.Views.Controls"
mc:Ignorable="d"
Loaded="OnPageLoaded"
Background="Transparent"
FlowDirection="LeftToRight"
Language="es-ES">

    <Page.Resources>
        <ResourceDictionary>
            <!-- ✅ SOLO CONVERTERS Y ESTILOS - Los temas ahora están en App.xaml -->
            <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <helpers:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <helpers:BoolToColorConverter x:Key="BoolToColorConverter"/>
            <helpers:EstadoToColorConverter x:Key="EstadoToColorConverter"/>
            <helpers:EstadoToIconConverter x:Key="EstadoToIconConverter"/>
            <helpers:EstadoToActionVisibilityConverter x:Key="EstadoToActionVisibilityConverter"/>
            
            <!-- Converters para el estado del servicio -->
            <helpers:ServiceStatusToBrushConverter x:Key="ServiceStatusToBrushConverter"/>
            <helpers:ServiceStatusToTextConverter x:Key="ServiceStatusToTextConverter"/>
            <helpers:ServiceStatusToVisibilityConverter x:Key="ServiceStatusToVisibilityConverter"/>

            <!-- ✅ Converter para colores hexadecimales -->
            <helpers:HexColorToBrushConverter x:Key="HexColorToBrushConverter"/>

            <!-- ✅ Converter para Zebra Rows (filas alternadas) -->
            <helpers:AlternationIndexToBrushConverter x:Key="AlternationIndexToBrushConverter">
                <helpers:AlternationIndexToBrushConverter.EvenBrush>
                    <SolidColorBrush Color="Transparent"/>
                </helpers:AlternationIndexToBrushConverter.EvenBrush>
                <helpers:AlternationIndexToBrushConverter.OddBrush>
                    <SolidColorBrush Color="#14000000"/>
                </helpers:AlternationIndexToBrushConverter.OddBrush>
            </helpers:AlternationIndexToBrushConverter>

            <!-- GT-BEGIN: Brushes de filas para code-behind (tema claro/oscuro) -->
            <SolidColorBrush x:Key="EvenRowBrush" Color="Transparent"/>
            <SolidColorBrush x:Key="OddRowBrush" Color="Transparent" Opacity="0.85"/>
            <!-- GT-END -->

            <!-- ✅ ESTILOS (usan ThemeResource de App.xaml) -->
            <Style x:Key="MutedText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource AppTextSecondaryBrush}"/>
            </Style>
            <Style x:Key="PanelBorder" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AppSurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
            </Style>
            <Style x:Key="TealBar" TargetType="Grid">
                <Setter Property="Height" Value="38"/>
                <Setter Property="Background" Value="{ThemeResource AppInputBackgroundBrush}"/>
            </Style>
            <Style x:Key="TealInnerTextBox" TargetType="TextBox">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style x:Key="TealCalendar" TargetType="CalendarDatePicker">
                <Setter Property="Background" Value="{ThemeResource AppInputBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="0"/>
                <Setter Property="Height" Value="38"/>
            </Style>
            <Style x:Key="MiniIconButton" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource AppSurfaceVariantBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="10,8"/>
            </Style>
            <Style x:Key="ThemeButton" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource AppSurfaceVariantBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="10,8"/>
            </Style>
            <Style x:Key="ToolButton" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource AppSurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="0"/>
                <Setter Property="MinWidth" Value="72"/>
                <Setter Property="Padding" Value="12,12"/>
            </Style>
            <Style x:Key="ToolbarButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{ThemeResource AppPrimaryBrush}"/>
                <Setter Property="Width" Value="80"/>
                <Setter Property="Height" Value="70"/>
                <Setter Property="Padding" Value="8"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Transitions">
                    <Setter.Value>
                        <TransitionCollection>
                            <RepositionThemeTransition/>
                        </TransitionCollection>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="EstadoIconButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
            </Style>
            <Style x:Key="HistoryNavButton" TargetType="Button">
                <Setter Property="Width" Value="32"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="Foreground" Value="{ThemeResource AppTextSecondaryBrush}"/>
            </Style>

        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="RootGrid" Padding="10" RowSpacing="10" Opacity="0">
        <Grid.Background>
            <ImageBrush x:Name="BackgroundImageBrush" 
                       ImageSource="ms-appx:///Assets/diario_bg_dark.png" 
                       Stretch="UniformToFill" 
                       AlignmentX="Center" 
                       AlignmentY="Center"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- BANNER -->
        <Border Grid.Row="0" Background="{ThemeResource AppPrimaryBrush}" CornerRadius="10" Padding="16">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Logo -->
                <Border Grid.Column="0" Background="Transparent" CornerRadius="6" VerticalAlignment="Center">
                    <Image x:Name="LogoImageBanner" 
                           Source="ms-appx:///Assets/LogoOscuro.png" 
                           Stretch="Uniform"
                           MaxHeight="60"
                           HorizontalAlignment="Left"/>
                </Border>
                
                <!-- Título + Info de Usuario -->
                <StackPanel Grid.Column="1" 
                            VerticalAlignment="Center" 
                            Spacing="4"
                            Margin="8,0,0,0">
                    <!-- Título Principal -->
                    <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="White"/>
                    
                    <!-- Usuario -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE77B;" 
                                  FontSize="14" 
                                  Foreground="White" 
                                  Opacity="0.9"
                                  VerticalAlignment="Center"/>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.DisplayName, Mode=OneWay}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="White"/>
                            <TextBlock Text="{x:Bind ViewModel.DisplayEmail, Mode=OneWay}"
                                       FontSize="12"
                                       Foreground="White"
                                       Opacity="0.8"/>
                            
                            <!-- Teléfono dinámico (sin icono, alineado como tarjeta) -->
                            <TextBlock Text="{x:Bind ViewModel.DisplayPhone, Mode=OneWay}"
                                       FontSize="12" 
                                       Foreground="White" 
                                       Opacity="0.8"
                                       Visibility="{x:Bind ViewModel.DisplayPhone, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                
                <!-- Columna derecha: Botones + Estado Servicio -->
                <StackPanel Grid.Column="2" 
                            VerticalAlignment="Center"
                            Spacing="12">

                    <!-- Fila de botones (Configuración y Ayuda en horizontal) -->
                    <StackPanel Orientation="Horizontal" 
                                Spacing="8" 
                                HorizontalAlignment="Center">
                        <!-- Botón de Configuración -->
                        <Button x:Name="BtnSettings" 
                                Background="Transparent" 
                                BorderBrush="White" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="10,8" 
                                ToolTipService.ToolTip="Configuración"
                                Click="OnOpenUserSettings">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE713;" Foreground="White"/>
                        </Button>

                        <!-- Botón de Ayuda -->
                        <Button x:Name="BtnHelp" 
                                Background="Transparent" 
                                BorderBrush="White" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="10,8" 
                                ToolTipService.ToolTip="Ver notas de versión y cambios recientes"
                                Click="OnNotasVersionClick">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE946;" Foreground="White"/>
                        </Button>

                        <!-- Botón de Tema (icono) -->
                        <Button x:Name="BtnThemeDiario"
                                Background="Transparent"
                                BorderBrush="White"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,8"
                                Click="OnToggleThemeClick"
                                ToolTipService.ToolTip="Cambiar tema">
                            <FontIcon x:Name="IconThemeDiario" FontFamily="Segoe MDL2 Assets" Glyph="&#xE706;" Foreground="White"/>
                        </Button>
                    </StackPanel>

                    <!-- Estado del Servicio -->
                    <Grid HorizontalAlignment="Center"
                          ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- LED Circular con Glow -->
                        <Grid Grid.Column="0" Width="12" Height="12">
                            <!-- Glow effect (círculo exterior difuminado) -->
                            <Ellipse Fill="{x:Bind ViewModel.IsServiceOnline, Mode=OneWay, Converter={StaticResource ServiceStatusToBrushConverter}}"
                                     Opacity="0.4"
                                     Width="16"
                                     Height="16"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform ScaleX="1.3" ScaleY="1.3"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            
                            <!-- LED principal -->
                            <Ellipse Fill="{x:Bind ViewModel.IsServiceOnline, Mode=OneWay, Converter={StaticResource ServiceStatusToBrushConverter}}"
                                     Width="12"
                                     Height="12"/>
                        </Grid>
                        
                        <!-- Texto del Estado -->
                        <StackPanel Grid.Column="1" 
                                    Orientation="Horizontal" 
                                    Spacing="6"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Servicio:"
                                       FontSize="12"
                                       Foreground="White"
                                       Opacity="0.8"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Bind ViewModel.IsServiceOnline, Mode=OneWay, Converter={StaticResource ServiceStatusToTextConverter}}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                            
                            <!-- Icono de advertencia (solo offline) -->
                            <FontIcon Glyph="&#xE7BA;" 
                                      FontSize="11" 
                                      Foreground="{ThemeResource AppWarningBrush}"
                                      Visibility="{x:Bind ViewModel.IsServiceOnline, Mode=OneWay, Converter={StaticResource ServiceStatusToVisibilityConverter}}"
                                      ToolTipService.ToolTip="Sin conexión con el servidor"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- FILTROS + BOTONES -->
        <Border Grid.Row="1" Background="Transparent" Padding="10">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Columna izquierda: Fecha y Búsqueda -->
                <StackPanel Grid.Column="0" Spacing="4" HorizontalAlignment="Left" MaxWidth="520">
                    <!-- Fecha -->
                    <TextBlock Text="Fecha" Style="{StaticResource MutedText}"/>
                    <Grid ColumnSpacing="8" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CalendarDatePicker x:Name="DpFiltroFecha"
                                            Style="{StaticResource TealCalendar}"
                                            Width="175"
                                            MaxWidth="175"
                                            DateFormat="{}{day.integer(2)}-{month.integer(2)}-{year.full}"/>
                        <TextBlock x:Name="TxtSemanaIso"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{ThemeResource AppTextSecondaryBrush}"/>
                        <Button Grid.Column="2"
                                Style="{StaticResource MiniIconButton}"
                                Click="OnRefrescar"
                                ToolTipService.ToolTip="Refrescar (F5)"
                                Height="38">
                            <FontIcon FontFamily="Segoe Fluent Icons"
                                      Glyph="&#xE72C;"
                                      Foreground="{ThemeResource AppPrimaryBrush}"/>
                        </Button>
                    </Grid>

                    <!-- GT-BEGIN: Búsqueda avanzada con sugerencias y pills -->
                    <TextBlock Text="Buscar" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                    <AutoSuggestBox x:Name="TxtFiltroQ"
                                    PlaceholderText="cliente, grupo, tipo, ticket, tags..."
                                    QueryIcon="Find"
                                    TextChanged="OnFiltroQChanged"
                                    QuerySubmitted="OnFilterQuerySubmitted"
                                    Background="{ThemeResource AppInputBackgroundBrush}"
                                    Foreground="{ThemeResource AppTextPrimaryBrush}"
                                    Height="38"
                                    FontSize="14"
                                    BorderThickness="0"
                                    HorizontalAlignment="Stretch"
                                    MaxWidth="520"/>
                    <StackPanel x:Name="PnlFilterPills"
                                Orientation="Horizontal"
                                Spacing="6"
                                Margin="0,2,0,0"/>
                    <!-- GT-END: Búsqueda avanzada con sugerencias y pills -->

                    <StackPanel x:Name="PnlAgenteFiltro" Visibility="Collapsed" Spacing="4" Margin="0,4,0,0" MaxWidth="520">
                        <TextBlock Text="Agente" Style="{StaticResource MutedText}"/>
                        <ComboBox x:Name="CmbAgenteFiltro"
                                  HorizontalAlignment="Stretch"
                                  MaxWidth="520"
                                  SelectionChanged="OnAgenteFiltroChanged"
                                  Background="{ThemeResource AppInputBackgroundBrush}"
                                  Foreground="{ThemeResource AppTextPrimaryBrush}"
                                  BorderBrush="{ThemeResource AppBorderBrush}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Display}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap"
                                               ToolTipService.ToolTip="{Binding Display}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <Border x:Name="BannerReadOnlyAgent"
                            Visibility="Collapsed"
                            Background="{ThemeResource AppSurfaceVariantBrush}"
                            BorderBrush="{ThemeResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,6"
                            Margin="0,6,0,0">
                        <TextBlock x:Name="TxtReadOnlyAgent"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{ThemeResource AppTextPrimaryBrush}"/>
                    </Border>
                </StackPanel>
                
                <!-- Barra de botones -->
                <Border Grid.Column="2" BorderBrush="{ThemeResource AppPrimaryBrush}" BorderThickness="2" Padding="8" CornerRadius="6" Background="{ThemeResource AppElevatedSurfaceBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <!-- Llamada telefónica rápida -->
                        <Button x:Name="BtnTelefono" Style="{StaticResource ToolbarButton}" Click="OnNuevaLlamada" 
                                ToolTipService.ToolTip="Nueva llamada telefónica (Ctrl+T)"
                                PointerEntered="OnButtonPointerEntered"
                                PointerExited="OnButtonPointerExited">
                            <StackPanel Spacing="4">
                                <FontIcon Glyph="&#xE717;" FontSize="24" Foreground="{ThemeResource AppSuccessBrush}"/>
                                <TextBlock Text="Teléfono" FontSize="11" Foreground="{ThemeResource AppTextPrimaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                        <Button x:Name="BtnNuevo" Style="{StaticResource ToolbarButton}" Click="OnNuevo" 
                                ToolTipService.ToolTip="Nuevo parte (Ctrl+N)"
                                PointerEntered="OnButtonPointerEntered"
                                PointerExited="OnButtonPointerExited">
                            <StackPanel Spacing="4">
                                <FontIcon Glyph="&#xE710;" FontSize="24" Foreground="{ThemeResource AppInfoBrush}"/>
                                <TextBlock Text="Nuevo" FontSize="11" Foreground="{ThemeResource AppTextPrimaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnEditar" Style="{StaticResource ToolbarButton}" Click="OnEditar" IsEnabled="False" 
                                ToolTipService.ToolTip="Editar parte seleccionado (Ctrl+E)"
                                PointerEntered="OnButtonPointerEntered"
                                PointerExited="OnButtonPointerExited">
                            <StackPanel Spacing="4">
                                <FontIcon x:Name="IconEditar" Glyph="&#xE70F;" FontSize="24" Foreground="{ThemeResource AppPrimaryBrush}"/>
                                <TextBlock Text="Editar" FontSize="11" Foreground="{ThemeResource AppTextPrimaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                        <!-- Separador -->
                        <Border Width="1" Height="50" Background="{ThemeResource AppBorderBrush}" Margin="4,0" VerticalAlignment="Center"/>
                        
                        <!-- Grupo: Visualización -->
                        
                        <!-- Separador -->
                        <Border Width="1" Height="50" Background="{ThemeResource AppBorderBrush}" Margin="4,0" VerticalAlignment="Center"/>
                        
                        <!-- Grupo: Administración -->
                        <Button x:Name="BtnBorrar" Style="{StaticResource ToolbarButton}" Click="OnBorrar" IsEnabled="False"
                                ToolTipService.ToolTip="Borrar parte seleccionado (Delete)"
                                PointerEntered="OnButtonPointerEntered"
                                PointerExited="OnButtonPointerExited">
                            <StackPanel Spacing="4">
                                <FontIcon Glyph="&#xE74D;" FontSize="24" Foreground="{ThemeResource AppErrorBrush}"/>
                                <TextBlock Text="Borrar" FontSize="11" Foreground="{ThemeResource AppTextPrimaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                        <!-- 🆕 NUEVO: Botón Importar Excel -->
                        <Button x:Name="BtnImportar" Style="{StaticResource ToolbarButton}" Click="OnImportarExcel" 
                                ToolTipService.ToolTip="Importar partes desde Excel (Ctrl+I)"
                                PointerEntered="OnButtonPointerEntered"
                                PointerExited="OnButtonPointerExited">
                            <StackPanel Spacing="4">
                                <FontIcon Glyph="&#xE8B5;" FontSize="24" Foreground="{ThemeResource AppPrimaryBrush}"/>
                                <TextBlock Text="Importar" FontSize="11" Foreground="{ThemeResource AppTextPrimaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                        <!-- 🆕 NUEVO: Botón Exportar Excel -->
                        <Button x:Name="BtnExportar" 
                                Style="{StaticResource ToolbarButton}" 
                                Click="OnExportarExcel" 
                                IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                                ToolTipService.ToolTip="Exportar partes a Excel por semana (Ctrl+X)"
                                PointerEntered="OnButtonPointerEntered"
                                PointerExited="OnButtonPointerExited">
                            <StackPanel Spacing="4">
                                <FontIcon Glyph="&#xE8A5;" FontSize="24" Foreground="{ThemeResource AppSuccessBrush}"/>
                                <TextBlock Text="Exportar" FontSize="11" Foreground="{ThemeResource AppTextPrimaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                        <!-- Separador -->
                        <Border Width="1" Height="50" Background="{ThemeResource AppBorderBrush}" Margin="4,0" VerticalAlignment="Center"/>
                        
                        <!-- 🆕 NUEVO: Botón Usuarios Online -->
                        <Button x:Name="BtnUsersOnline" Style="{StaticResource ToolbarButton}" Click="OnToggleUsersPanel" 
                                ToolTipService.ToolTip="Ver usuarios online"
                                PointerEntered="OnButtonPointerEntered"
                                PointerExited="OnButtonPointerExited">
                            <StackPanel Spacing="4">
                                <FontIcon Glyph="&#xE716;" FontSize="24" Foreground="{ThemeResource AppPrimaryBrush}"/>
                                <TextBlock Text="Usuarios" FontSize="11" Foreground="{ThemeResource AppTextPrimaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 🆕 NUEVO: Botón Informes (reemplaza a Ayuda en la barra inferior) -->
                        <Button x:Name="BtnInformes" Style="{StaticResource ToolbarButton}" 
                                Click="OnOpenInformes"
                                ToolTipService.ToolTip="Ver informes y estadísticas"
                                PointerEntered="OnButtonPointerEntered"
                                PointerExited="OnButtonPointerExited">
                            <StackPanel Spacing="4">
                                <FontIcon Glyph="&#xE9F9;" FontSize="24" Foreground="{ThemeResource AppWarningBrush}"/>
                                <TextBlock Text="Informes" FontSize="11" Foreground="{ThemeResource AppTextPrimaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                        <!-- 🆕 NUEVO: Botón Salir -->
                        <Button x:Name="BtnSalir" Style="{StaticResource ToolbarButton}" Click="OnLogout" 
                                ToolTipService.ToolTip="Cerrar sesión (Ctrl+Q)"
                                PointerEntered="OnButtonPointerEntered"
                                PointerExited="OnButtonPointerExited">
                            <StackPanel Spacing="4">
                                <FontIcon Glyph="&#xE7E8;" FontSize="24" Foreground="{ThemeResource AppErrorBrush}"/>
                                <TextBlock Text="Salir" FontSize="11" Foreground="{ThemeResource AppTextPrimaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- LISTVIEW CON SURFACE CONTAINER + PANEL USUARIOS ONLINE -->
        <SplitView Grid.Row="2"
                   x:Name="MainSplitView"
                   DisplayMode="Inline"
                   IsPaneOpen="False"
                   OpenPaneLength="380"
                   PaneBackground="Transparent"
                   PanePlacement="Right">
            
            <!-- Panel lateral: Usuarios Online -->
            <SplitView.Pane>
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1,0,0,0"
                        CornerRadius="0,14,14,0">
                    <local:OnlineUsersPanel x:Name="UsersPanel"/>
                </Border>
            </SplitView.Pane>
            
            <!-- Contenido principal: ListView de partes -->
            <Border Background="{ThemeResource AppSurfaceBrush}"
                    BorderBrush="{ThemeResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="12">
                <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Cabecera -->
                <Grid x:Name="HeaderGrid" Background="{ThemeResource AppPrimaryPressedBrush}" Padding="4,8,8,8" CornerRadius="8,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="55"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="55"/>
                        <ColumnDefinition Width="55"/>
                        <ColumnDefinition Width="45"/>
                        <ColumnDefinition Width="65"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="80"/>  <!-- Tags -->
                        <ColumnDefinition Width="90"/>  <!-- Estado -->
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="2" Text="Fecha" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock Grid.Column="3" Text="Cliente" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock Grid.Column="4" Text="Tienda" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock Grid.Column="5" Text="Acción" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock Grid.Column="6" Text="Inicio" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock Grid.Column="7" Text="Fin" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                    <!-- 🆕 Header "Dur." con tooltip dinámico -->
                    <TextBlock x:Name="DuracionHeader" 
                               Grid.Column="8" 
                               Text="Dur." 
                               Foreground="White" 
                               FontWeight="SemiBold" 
                               FontSize="12"
                               ToolTipService.ToolTip="Pasa el ratón para ver estadísticas de tiempo"
                               ToolTipService.Placement="Bottom"/>
                    <TextBlock Grid.Column="9" Text="Ticket" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock Grid.Column="10" Text="Grupo" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock Grid.Column="11" Text="Tipo" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock Grid.Column="12" Text="Tags" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock Grid.Column="13" Text="Estado" Foreground="White" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                </Grid>

                <!-- ✅ ListView con Zebra Rows -->
                <ListView Grid.Row="1" 
                          x:Name="LvPartes" 
                          SelectionMode="Single" 
                          Background="Transparent" 
                          BorderThickness="0" 
                          SelectionChanged="OnPartesSelectionChanged">
                    <ListView.Header>
                        <Grid x:Name="PnlShowLessHistory" Height="32" Visibility="Collapsed">
                            <Button x:Name="BtnShowLessHistory"
                                    Style="{StaticResource HistoryNavButton}"
                                    Visibility="Collapsed"
                                    Click="OnShowLessHistoryClick"
                                    ToolTipService.ToolTip="Mostrar menos registros"
                                    AutomationProperties.Name="Mostrar menos registros">
                                <FontIcon FontFamily="Segoe Fluent Icons"
                                          Glyph="&#xE70E;"
                                          FontSize="16"
                                          Foreground="{ThemeResource AppTextSecondaryBrush}"/>
                            </Button>
                        </Grid>
                    </ListView.Header>
                    <ListView.Footer>
                        <Grid x:Name="PnlLoadMoreHistory" Height="32" Visibility="Collapsed">
                            <Button x:Name="BtnLoadMoreHistory"
                                    Style="{StaticResource HistoryNavButton}"
                                    Visibility="Collapsed"
                                    Click="OnLoadMoreHistoryClick"
                                    ToolTipService.ToolTip="Cargar más registros antiguos"
                                    AutomationProperties.Name="Cargar más registros antiguos">
                                <Grid>
                                    <FontIcon x:Name="IconLoadMoreHistory"
                                              FontFamily="Segoe Fluent Icons"
                                              Glyph="&#xE70D;"
                                              FontSize="16"
                                              Foreground="{ThemeResource AppTextSecondaryBrush}"/>
                                    <ProgressRing x:Name="RingLoadMoreHistory"
                                                  Width="16"
                                                  Height="16"
                                                  IsActive="False"
                                                  Visibility="Collapsed"/>
                                </Grid>
                            </Button>
                        </Grid>
                    </ListView.Footer>
                    <!-- ✅ RECURSOS DE ESTADOS VISUALES CON COLORES MEJORADOS -->
                    <ListView.Resources>
                        <ResourceDictionary>
                            <ResourceDictionary.ThemeDictionaries>
                                <ResourceDictionary x:Key="Light">
                                <StaticResource x:Key="ListViewItemBackground" ResourceKey="AppSurfaceBrush"/>
                                <StaticResource x:Key="ListViewItemBackgroundPointerOver" ResourceKey="AppListHoverBrush"/>
                                <StaticResource x:Key="ListViewItemBackgroundPressed" ResourceKey="AppListPressedBrush"/>
                                <StaticResource x:Key="ListViewItemBackgroundSelected" ResourceKey="AppListSelectedBrush"/>
                                <StaticResource x:Key="ListViewItemBackgroundSelectedPointerOver" ResourceKey="AppListSelectedBrush"/>
                                <StaticResource x:Key="ListViewItemBackgroundSelectedPressed" ResourceKey="AppListPressedBrush"/>
                                <StaticResource x:Key="ListViewItemBorderBrushPointerOver" ResourceKey="AppListSeparatorBrush"/>
                                <StaticResource x:Key="ListViewItemBorderBrushPressed" ResourceKey="AppListSeparatorBrush"/>
                                <StaticResource x:Key="ListViewItemBorderBrushSelected" ResourceKey="AppPrimaryBrush"/>
                                <StaticResource x:Key="ListViewItemBorderBrushSelectedPointerOver" ResourceKey="AppPrimaryBrush"/>
                                <StaticResource x:Key="ListViewItemBorderBrushSelectedPressed" ResourceKey="AppPrimaryBrush"/>
                                <StaticResource x:Key="ListViewItemForeground" ResourceKey="AppTextPrimaryBrush"/>
                                <StaticResource x:Key="ListViewItemForegroundPointerOver" ResourceKey="AppTextPrimaryBrush"/>
                                <StaticResource x:Key="ListViewItemForegroundPressed" ResourceKey="AppTextPrimaryBrush"/>
                                <StaticResource x:Key="ListViewItemForegroundSelected" ResourceKey="AppTextPrimaryBrush"/>
                                <StaticResource x:Key="ListViewItemForegroundSelectedPointerOver" ResourceKey="AppTextPrimaryBrush"/>
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="Dark">
                                <StaticResource x:Key="ListViewItemBackground" ResourceKey="AppSurfaceBrush"/>
                                <StaticResource x:Key="ListViewItemBackgroundPointerOver" ResourceKey="AppListHoverBrush"/>
                                <StaticResource x:Key="ListViewItemBackgroundPressed" ResourceKey="AppListPressedBrush"/>
                                <StaticResource x:Key="ListViewItemBackgroundSelected" ResourceKey="AppListSelectedBrush"/>
                                <StaticResource x:Key="ListViewItemBackgroundSelectedPointerOver" ResourceKey="AppListSelectedBrush"/>
                                <StaticResource x:Key="ListViewItemBackgroundSelectedPressed" ResourceKey="AppListPressedBrush"/>
                                <StaticResource x:Key="ListViewItemBorderBrushPointerOver" ResourceKey="AppListSeparatorBrush"/>
                                <StaticResource x:Key="ListViewItemBorderBrushPressed" ResourceKey="AppListSeparatorBrush"/>
                                <StaticResource x:Key="ListViewItemBorderBrushSelected" ResourceKey="AppPrimaryBrush"/>
                                <StaticResource x:Key="ListViewItemBorderBrushSelectedPointerOver" ResourceKey="AppPrimaryBrush"/>
                                <StaticResource x:Key="ListViewItemBorderBrushSelectedPressed" ResourceKey="AppPrimaryBrush"/>
                                <StaticResource x:Key="ListViewItemForeground" ResourceKey="AppTextPrimaryBrush"/>
                                <StaticResource x:Key="ListViewItemForegroundPointerOver" ResourceKey="AppTextPrimaryBrush"/>
                                <StaticResource x:Key="ListViewItemForegroundPressed" ResourceKey="AppTextPrimaryBrush"/>
                                <StaticResource x:Key="ListViewItemForegroundSelected" ResourceKey="AppSelectedForegroundBrush"/>
                                <StaticResource x:Key="ListViewItemForegroundSelectedPointerOver" ResourceKey="AppSelectedForegroundBrush"/>
                                </ResourceDictionary>
                            </ResourceDictionary.ThemeDictionaries>
                            <x:Boolean x:Key="ListViewItemRevealBackgroundShowsAboveContent">False</x:Boolean>
                        </ResourceDictionary>
                    </ListView.Resources>
                    
                    <!-- ✅ ItemContainerStyle sin Background (se establece dinámicamente) -->
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <!-- Background se establece dinámicamente en ContainerContentChanging -->
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,1"/>
                            <Setter Property="MinHeight" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="4,4,8,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="55"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="55"/>
                                    <ColumnDefinition Width="55"/>
                                    <ColumnDefinition Width="45"/>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Margin="0,1,0,1"
                                        Background="{Binding StatusForegroundColor, Converter={StaticResource HexColorToBrushConverter}}"
                                        CornerRadius="2"/>
                                <TextBlock Grid.Column="2" Text="{Binding FechaText}" TextWrapping="NoWrap" FontSize="13" Foreground="{ThemeResource AppTextPrimaryBrush}"/>
                                <TextBlock Grid.Column="3"
                                           Text="{Binding Cliente}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource AppTextPrimaryBrush}"/>
                                <TextBlock Grid.Column="4"
                                           Text="{Binding Tienda}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           FontSize="13"
                                           Foreground="{ThemeResource AppTextPrimaryBrush}"/>
                                <TextBlock Grid.Column="5"
                                           Text="{Binding Accion}"
                                           TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap"
                                            MaxLines="4"
                                           FontSize="13"
                                            ToolTipService.ToolTip="{Binding Accion}"
                                           Foreground="{ThemeResource AppTextPrimaryBrush}"/>
                                <TextBlock Grid.Column="6"
                                           Text="{Binding HoraInicio}"
                                           TextWrapping="NoWrap"
                                           FontSize="13"
                                           Foreground="{ThemeResource AppTextPrimaryBrush}"/>
                                <TextBlock Grid.Column="7"
                                           Text="{Binding HoraFin}"
                                           TextWrapping="NoWrap"
                                           FontSize="13"
                                           Foreground="{ThemeResource AppTextPrimaryBrush}"/>
                                <TextBlock Grid.Column="8"
                                           Text="{Binding DuracionText}"
                                           TextWrapping="NoWrap"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource AppTextPrimaryBrush}"/>
                                <Border Grid.Column="9"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding Ticket, Converter={StaticResource StringToVisibilityConverter}}"
                                        Background="Transparent"
                                        BorderBrush="{ThemeResource AppBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="5,2">
                                    <HyperlinkButton Content="{Binding Ticket}"
                                                     Tag="{Binding Ticket}"
                                                     Click="OnTicketClick"
                                                     Padding="0"
                                                     Margin="0"
                                                     FontSize="11"
                                                     MaxWidth="53"
                                                     ToolTipService.ToolTip="Abrir ticket en Freshdesk"
                                                     Foreground="{ThemeResource AppPrimaryBrush}"/>
                                </Border>
                                <TextBlock Grid.Column="10"
                                           Text="{Binding Grupo}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           FontSize="13"
                                           Foreground="{ThemeResource AppTextPrimaryBrush}"/>
                                <Border Grid.Column="11"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding Tipo, Converter={StaticResource StringToVisibilityConverter}}"
                                        Background="{ThemeResource AppSurfaceVariantBrush}"
                                        BorderBrush="{ThemeResource AppBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="5,2">
                                    <TextBlock Text="{Binding Tipo}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap"
                                               FontSize="11"
                                               MaxWidth="58"
                                               Foreground="{ThemeResource AppTextSecondaryBrush}"/>
                                </Border>
                                <!-- Tags: primer tag visible + tooltip con todos los tags -->
                                <Border Grid.Column="12"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                         Visibility="{Binding FirstTag, Converter={StaticResource StringToVisibilityConverter}}"
                                        Background="Transparent">
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <Border Background="{ThemeResource AppPrimaryContainerBrush}"
                                                BorderBrush="{ThemeResource AppPrimaryBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="6,3">
                                            <TextBlock Text="{Binding FirstTag}"
                                                       FontSize="10"
                                                       Foreground="{ThemeResource AppOnPrimaryContainerBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"
                                                       MaxWidth="48"/>
                                        </Border>
                                        <TextBlock Text="{Binding Tags, Converter={StaticResource TagOverflowTextConverter}}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <ToolTipService.ToolTip>
                                        <ToolTip>
                                            <ItemsControl ItemsSource="{Binding Tags}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{ThemeResource AppPrimaryContainerBrush}"
                                                                BorderBrush="{ThemeResource AppPrimaryBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="8"
                                                                Padding="6,3"
                                                                Margin="0,2">
                                                            <TextBlock Text="{Binding}"
                                                                       FontSize="10"
                                                                       Foreground="{ThemeResource AppOnPrimaryContainerBrush}"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Vertical" Spacing="3"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </ToolTip>
                                    </ToolTipService.ToolTip>
                                </Border>

                                <!-- Estado: pill con acciones -->
                                <Button Grid.Column="13"
                                        Style="{StaticResource EstadoIconButton}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsEnabled="{Binding ElementName=BtnNuevo, Path=IsEnabled}"
                                        ToolTipService.ToolTip="{Binding EstadoTexto}"
                                        Tag="{Binding Id}">
                                    <Border Background="{Binding StatusBackgroundColor, Converter={StaticResource HexColorToBrushConverter}}"
                                            CornerRadius="10"
                                            Padding="6,3">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon FontFamily="Segoe MDL2 Assets"
                                                      Glyph="{Binding StatusIcon}"
                                                      Foreground="{Binding StatusForegroundColor, Converter={StaticResource HexColorToBrushConverter}}"
                                                      FontSize="10"/>
                                            <TextBlock Text="{Binding StatusText}"
                                                       Foreground="{Binding StatusForegroundColor, Converter={StaticResource HexColorToBrushConverter}}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Pausar" Click="OnPausarClick" Tag="{Binding Id}" Visibility="{Binding CanPausar, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE769;" Foreground="{ThemeResource AppWarningBrush}"/>
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Reanudar" Click="OnReanudarClick" Tag="{Binding Id}" Visibility="{Binding CanReanudar, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE768;" Foreground="{ThemeResource AppSuccessBrush}"/>
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Cerrar" Click="OnCerrarClick" Tag="{Binding Id}" Visibility="{Binding CanCerrar, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE73E;" Foreground="{ThemeResource AppInfoBrush}"/>
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Duplicar" Click="OnDuplicarClick" Tag="{Binding Id}" Visibility="{Binding CanDuplicar, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8C8;" Foreground="{ThemeResource AppPrimaryBrush}"/>
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
        </SplitView>
        
        <!-- 🆕 OVERLAY DE CARGA - Solo ProgressRing centrado más abajo -->
        <Grid x:Name="LoadingOverlay"
              Grid.RowSpan="3"
              Background="{ThemeResource AppOverlayBrush}"
              Visibility="Collapsed"
              Canvas.ZIndex="1000">
            <ProgressRing x:Name="LoadingRing"
                          IsActive="False"
                          Width="80"
                          Height="80"
                          Foreground="{ThemeResource AppPrimaryBrush}"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"
                          Margin="0,100,0,0"/>
        </Grid>
    </Grid>
</Page>
