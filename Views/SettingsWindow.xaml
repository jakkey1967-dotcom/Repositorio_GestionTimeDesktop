<Window
x:Class="GestionTime.Desktop.Views.SettingsWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
mc:Ignorable="d"
Title="Configuración - GestionTime">

<Grid Background="#0F1419">
    <Grid.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#16A8B8"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1A2332"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#2D3E50"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E6EDF3"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#AAB4BF"/>
    </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>   <!-- Menú izquierda -->
            <ColumnDefinition Width="*"/>     <!-- Contenido derecha -->
        </Grid.ColumnDefinitions>

        <!-- ========== COLUMNA IZQUIERDA: MENÚ ========== -->
        <Border Grid.Column="0"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid RowSpacing="12" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- Header -->
                    <RowDefinition Height="Auto"/>   <!-- Buscador -->
                    <RowDefinition Height="*"/>      <!-- Lista de secciones -->
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Spacing="4">
                    <TextBlock Text="Configuración"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Gestiona las opciones de la aplicación"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>

                <!-- Buscador -->
                <TextBox x:Name="TxtSearch"
                         Grid.Row="1"
                         PlaceholderText="Buscar en configuración..."
                         Background="#0D1117"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         BorderBrush="#30363D"
                         BorderThickness="1"
                         CornerRadius="6"
                         Padding="10,8"
                         FontSize="13"
                         TextChanged="OnSearchTextChanged"/>

                <!-- Lista de secciones -->
                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              Margin="0,8,0,0">
                    <ItemsControl x:Name="SectionsList"
                                  ItemsSource="{Binding FilteredSections, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="OnSectionClick"
                                        Tag="{Binding}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="12,10"
                                        Margin="0,0,0,4"
                                        CornerRadius="6">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>   <!-- Icono -->
                                            <ColumnDefinition Width="*"/>      <!-- Texto -->
                                            <ColumnDefinition Width="Auto"/>   <!-- Candado -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Icono de sección -->
                                        <FontIcon Grid.Column="0"
                                                  FontFamily="Segoe MDL2 Assets"
                                                  Glyph="{Binding Icon, Mode=OneTime}"
                                                  FontSize="18"
                                                  Foreground="{StaticResource AccentBrush}"
                                                  VerticalAlignment="Center"/>

                                        <!-- Título de sección -->
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Title, Mode=OneTime}"
                                                   FontSize="16"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,8,0"/>

                                        <!-- Candado (abierto/cerrado) -->
                                        <FontIcon Grid.Column="2"
                                                  FontFamily="Segoe MDL2 Assets"
                                                  Glyph="{Binding LockIcon, Mode=OneTime}"
                                                  FontSize="16"
                                                  Foreground="{Binding LockBrush, Mode=OneTime}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Right"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ========== COLUMNA DERECHA: CONTENIDO ========== -->
        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="24">
            <StackPanel x:Name="ContentPanel" Spacing="20">
                <!-- Header de sección -->
                <StackPanel Spacing="8">
                    <TextBlock x:Name="TxtSectionTitle"
                               Text="Selecciona una sección"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="TxtSectionDescription"
                               Text="Usa el menú de la izquierda para navegar"
                               FontSize="14"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>

                <!-- InfoBar de acceso denegado -->
                <InfoBar x:Name="AccessDeniedInfoBar"
                         IsOpen="False"
                         Severity="Warning"
                         Title="Acceso denegado"
                         Message="No tienes permisos para acceder a esta sección."
                         IsClosable="True"
                         Closed="OnAccessDeniedInfoBarClosed"/>

                <!-- Contenido dinámico -->
                <Border x:Name="SectionContentContainer"
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        MinHeight="400">
                    <!-- El contenido se cargará dinámicamente según la sección -->
                    <TextBlock x:Name="TxtPlaceholder"
                               Text="Contenido de la sección se cargará aquí"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
