<Project>
  <!-- Configuración global para todos los proyectos en esta solución -->
  
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- ═══════════════════════════════════════════════════════════════ -->
  <!-- VERSIÓN CENTRALIZADA - FUENTE ÚNICA DE VERDAD                   -->
  <!-- ═══════════════════════════════════════════════════════════════ -->
  <PropertyGroup>
    <!-- 🎯 VERSIÓN DE LA APLICACIÓN - Modificar SOLO AQUÍ -->
    <AppVersionMajor>1</AppVersionMajor>
    <AppVersionMinor>9</AppVersionMinor>
    <AppVersionPatch>5</AppVersionPatch>
    <AppVersionSuffix>-beta</AppVersionSuffix>

    <!-- Versión completa calculada automáticamente -->
    <AppVersion>$(AppVersionMajor).$(AppVersionMinor).$(AppVersionPatch)$(AppVersionSuffix)</AppVersion>
    <AppVersionNumeric>$(AppVersionMajor).$(AppVersionMinor).$(AppVersionPatch).0</AppVersionNumeric>
  </PropertyGroup>

  <!-- Información de ensamblado común -->
  <PropertyGroup>
    <Company>GestionTime Solutions</Company>
    <Copyright>© 2025 GestionTime Solutions</Copyright>
  </PropertyGroup>

</Project>
