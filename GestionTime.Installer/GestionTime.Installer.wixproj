<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputName>GestionTime.Desktop</OutputName>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!-- Referencias al proyecto principal -->
  <ItemGroup>
    <ProjectReference Include="..\GestionTime.Desktop.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <!-- Paquetes WiX necesarios -->
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="6.0.2" />
  </ItemGroup>

  <!-- Incluir archivos WiX -->
  <ItemGroup>
    <Compile Include="Package-Simple.wxs" />
  </ItemGroup>
</Project>

