<ContentDialog
    x:Class="GestionTime.Desktop.Dialogs.ExportWeekDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="📊 Exportar Partes a Excel"
    PrimaryButtonText="Exportar"
    CloseButtonText="Cancelar"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind IsRangeValid, Mode=OneWay}">

    <ContentDialog.Style>
        <Style TargetType="ContentDialog">
            <Setter Property="Background" Value="{ThemeResource AppDialogBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}"/>
        </Style>
    </ContentDialog.Style>

    <StackPanel Spacing="16" MinWidth="440">
        <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource AppTextSecondaryBrush}">
            Selecciona un rango de fechas. Se exportarán semanas ISO completas (lunes a domingo), incluso si las fechas caen a mitad de semana.
        </TextBlock>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="8">
                <TextBlock Text="Fecha inicial" FontWeight="SemiBold"/>
                <CalendarDatePicker x:Name="DpStartDate"
                                    Date="{x:Bind StartDate, Mode=TwoWay}"
                                    DateChanged="OnStartDateChanged"
                                    HorizontalAlignment="Stretch"
                                    PlaceholderText="Fecha inicial"
                                    FirstDayOfWeek="Monday"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="8">
                <TextBlock Text="Fecha final" FontWeight="SemiBold"/>
                <CalendarDatePicker x:Name="DpEndDate"
                                    Date="{x:Bind EndDate, Mode=TwoWay}"
                                    DateChanged="OnEndDateChanged"
                                    HorizontalAlignment="Stretch"
                                    PlaceholderText="Fecha final"
                                    FirstDayOfWeek="Monday"/>
            </StackPanel>
        </Grid>

        <StackPanel Spacing="8">
            <TextBlock Text="Modo de exportación" FontWeight="SemiBold"/>
            <ComboBox x:Name="ModeComboBox"
                      SelectedIndex="{x:Bind SelectedModeIndex, Mode=TwoWay}"
                      SelectionChanged="OnModeSelectionChanged"
                      HorizontalAlignment="Stretch"
                      Background="{ThemeResource AppInputBackgroundBrush}"
                      Foreground="{ThemeResource AppTextPrimaryBrush}"
                      BorderBrush="{ThemeResource AppBorderBrush}">
                <ComboBoxItem Content="Unificar en un solo archivo Excel"/>
                <ComboBoxItem Content="Generar un archivo Excel por semana"/>
            </ComboBox>
        </StackPanel>

        <Border Background="{ThemeResource AppSurfaceVariantBrush}"
                BorderBrush="{ThemeResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">
            <StackPanel Spacing="8">
                <TextBlock Text="📋 Información de exportación" FontWeight="SemiBold" FontSize="13"/>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE787;" FontSize="14" Foreground="{ThemeResource AppPrimaryBrush}"/>
                    <TextBlock Text="{x:Bind RangeSummaryText, Mode=OneWay}" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8FD;" FontSize="14" Foreground="{ThemeResource AppPrimaryBrush}"/>
                    <TextBlock Text="{x:Bind WeeksSummaryText, Mode=OneWay}" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8A5;" FontSize="14" Foreground="{ThemeResource AppPrimaryBrush}"/>
                    <TextBlock Text="{x:Bind ModeSummaryText, Mode=OneWay}" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8B7;" FontSize="14" Foreground="{ThemeResource AppPrimaryBrush}"/>
                    <TextBlock Text="{x:Bind FilesSummaryText, Mode=OneWay}" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8FE;" FontSize="14" Foreground="{ThemeResource AppPrimaryBrush}"/>
                    <TextBlock Text="Columnas: PROYECTO, FECHA, HORA INICIO, HORA FIN, DURACION, TAREA, GRUPO, TIPO"
                               FontSize="12"
                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <InfoBar IsOpen="{x:Bind ShowInvalidRange, Mode=OneWay}"
                 Severity="Error"
                 Title="Rango inválido"
                 Message="La fecha final no puede ser anterior a la fecha inicial."/>
    </StackPanel>
</ContentDialog>
